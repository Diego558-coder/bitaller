# ============================================================
#  Bitaller en LOCAL con WhatsApp real (cuenta de Meta de Nicolás)
#  1) Copie este archivo como  .env.local   (en la misma carpeta)
#  2) Complete las 3 líneas marcadas con  <-- COMPLETAR
# ============================================================

# Base de datos local embebida (no instale nada): se guarda en la carpeta .data
DATABASE_URL=
SEED_DEMO=true

# Cualquier texto largo inventado (protege las sesiones)
AUTH_SECRET=bitaller-local-cambie-esto-por-algo-largo-y-raro-123456

# <-- COMPLETAR: URL pública del túnel (la que muestra cloudflared, termina en .trycloudflare.com)
APP_URL=https://PEGUE-AQUI-LA-URL.trycloudflare.com

# ---- WhatsApp real (Meta) ----
WHATSAPP_MODE=meta
ALLOW_DEMO=true
# = BUSSINES_PHONE de Nicolás (Phone Number ID)
META_PHONE_NUMBER_ID=1524116884110974
# <-- COMPLETAR: token de acceso que genera Nicolás en Meta (empieza por EAA)
META_ACCESS_TOKEN=
# <-- COMPLETAR: Configuración de la app > Básica > Clave secreta de la app (de la app de Nicolás)
META_APP_SECRET=
# = WEBHOOK_VERIFY_TOKEN: el mismo texto que Nicolás pega en Meta al configurar el webhook
META_VERIFY_TOKEN=Diego&Nico&AngeloLoMasBellako
# = API_VERSION
META_GRAPH_VERSION=v27.0
# Sin plantillas: el cliente escribe "hola" primero y Bitaller responde con texto libre
META_TEMPLATE_COMPROBANTE=
META_TEMPLATE_RECORDATORIO=
META_TEMPLATE_LANG=es

PORT=3000
CRON_SECRET=bitaller-local
