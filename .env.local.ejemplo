# ============================================================
#  Bitaller en LOCAL con WhatsApp (app de Meta de Nicolás, modo desarrollo)
#  Número de prueba + token temporal. Sin publicar la app.
#  Solo hay que completar 2 líneas marcadas con  <-- COMPLETAR
# ============================================================

# Base de datos local embebida (carpeta .data). No instale nada.
DATABASE_URL=
SEED_DEMO=true
AUTH_SECRET=bitaller-local-cambie-esto-por-algo-largo-y-raro-123456

# <-- COMPLETAR: URL del túnel (la que muestra 2_TUNEL.bat)
APP_URL=https://PEGUE-AQUI-LA-URL.trycloudflare.com

WHATSAPP_MODE=meta
ALLOW_DEMO=true
PORT=3000

# Variables del equipo
BUSSINES_PHONE=1524116884110974
API_VERSION=v27.0
WEBHOOK_VERIFY_TOKEN=Diego&Nico&AngeloLoMasBellako
# <-- COMPLETAR: token temporal que genera Nicolás en Meta (empieza por EAA, dura 24 h)
ACCESS_TOKEN=

# Opcional: clave secreta de la app. Vacía = no se valida la firma (válido para el MVP local)
META_APP_SECRET=

# Sin plantillas: el cliente escribe "hola" primero y Bitaller responde con texto
META_TEMPLATE_COMPROBANTE=
META_TEMPLATE_RECORDATORIO=
META_TEMPLATE_LANG=es
CRON_SECRET=bitaller-local
