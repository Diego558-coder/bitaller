# ---- Base de datos ----
# Vacío = base de datos local embebida (PGlite) en ./.data, ideal para demo.
# Producción: cadena de conexión de Supabase (Settings > Database > Connection pooling, modo "Transaction", puerto 6543)
DATABASE_URL=
# Cargar datos de demostración si la base está vacía (true/false)
SEED_DEMO=true

# ---- Sesiones ----
# Cadena aleatoria larga (por ejemplo: openssl rand -hex 32)
AUTH_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# URL pública de la app (para enlaces y el webhook)
APP_URL=http://localhost:3000

# ---- WhatsApp ----
# demo = simula WhatsApp dentro de la app (/demo/whatsapp). meta = WhatsApp Cloud API real.
WHATSAPP_MODE=demo
# Desde developers.facebook.com > tu app > WhatsApp > Configuración de la API
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Clave secreta de la app (Configuración de la app > Básica) para validar la firma del webhook
META_APP_SECRET=
# Texto que tú inventas y pegas también en Meta al configurar el webhook
META_VERIFY_TOKEN=bitaller-verify
META_GRAPH_VERSION=v27.0
# Plantilla aprobada para el comprobante (opcional). Si está vacía se envía texto libre,
# que Meta solo entrega si el cliente escribió en las últimas 24 h.
META_TEMPLATE_COMPROBANTE=
META_TEMPLATE_RECORDATORIO=
META_TEMPLATE_LANG=es

# ---- Tareas programadas ----
# Clave para llamar /api/cron/recordatorios desde un cron externo
CRON_SECRET=cambia-esto
